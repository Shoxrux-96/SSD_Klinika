# === SSD Klinika — production environment ===
# Loyihani VPS'ga ko'chirganingizdan keyin bu faylni .env nomiga ko'chiring
# (`cp deploy/.env.example .env`), qiymatlarni to'ldiring va systemd/pm2
# shu faylni o'qiydi.

# --- Postgres ---
# VPS'da ishlab turgan Postgres uchun ulanish satri.
# Localdagi standart: postgres://ssd:STRONG_PASSWORD@127.0.0.1:5432/ssd_klinika
DATABASE_URL=postgres://ssd:STRONG_PASSWORD@127.0.0.1:5432/ssd_klinika

# --- API server ---
# API 127.0.0.1'da tinglaydi; Nginx reverse-proxy 443/80'da uzatadi.
PORT=5000
NODE_ENV=production

# Autentifikatsiya: productionda true qilib qo'ymang.
# false = har bir yozuv requesti x-api-key yoki /auth/login tokenini talab qiladi.
AUTH_DISABLED=false

# JWT imzolash kaliti — productionda MAJBURIY. Kuchli, tasodifiy qiymat:
#   openssl rand -base64 48
# Agar bo'sh yoki standart ("ssd-klinika-dev-secret-change-me") bo'lsa, server ishga tushmaydi.
JWT_SECRET=CHANGE_ME_WITH_RANDOM_48_BYTE_SECRET

# --- Loglar ---
LOG_LEVEL=info
